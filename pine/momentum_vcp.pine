//@version=6
indicator("Momentum VCP Breakout Engine V2.2", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

//====================================================
// INPUTS
//====================================================

//----------------------------------------------------
// TREND
//----------------------------------------------------
groupTrend = "1. Trend"

smaLength = input.int(
     50,
     "SMA Length",
     minval=10,
     group=groupTrend)

useTrendFilter = input.bool(
     true,
     "Use SMA Trend Filter",
     group=groupTrend)


//----------------------------------------------------
// VCP BASE
//----------------------------------------------------
groupBase = "2. VCP Base"

baseLookback = input.int(
     20,
     "Base Lookback",
     minval=5,
     maxval=100,
     group=groupBase)

tightLookback = input.int(
     5,
     "Tight Range Lookback",
     minval=3,
     maxval=20,
     group=groupBase)

maxBaseRangePct = input.float(
     12.0,
     "Maximum Base Range %",
     minval=0.5,
     step=0.5,
     group=groupBase)

maxTightRangePct = input.float(
     6.0,
     "Maximum Tight Range %",
     minval=0.5,
     step=0.5,
     group=groupBase)

requireTightening = input.bool(
     false,
     "Require Tightening",
     group=groupBase)

minSetupBars = input.int(
     5,
     "Minimum Setup Bars",
     minval=1,
     group=groupBase)

maxSetupBars = input.int(
     30,
     "Maximum Setup Bars",
     minval=5,
     group=groupBase)


//----------------------------------------------------
// VOLUME
//----------------------------------------------------
groupVolume = "3. Volume"

useVolumeContraction = input.bool(
     false,
     "Require Volume Contraction",
     group=groupVolume)

volumeLength = input.int(
     20,
     "Volume Average Length",
     minval=5,
     group=groupVolume)

volumeContractionRatio = input.float(
     0.90,
     "Contraction Ratio",
     minval=0.5,
     maxval=1.5,
     step=0.05,
     group=groupVolume)

useBreakoutVolume = input.bool(
     true,
     "Require Breakout Volume",
     group=groupVolume)

breakoutVolumeMultiplier = input.float(
     1.20,
     "Breakout Volume Multiplier",
     minval=0.5,
     step=0.05,
     group=groupVolume)


//----------------------------------------------------
// BREAKOUT
//----------------------------------------------------
groupBreakout = "4. Breakout"

breakoutBuffer = input.float(
     0.05,
     "Breakout Buffer %",
     minval=0.0,
     step=0.05,
     group=groupBreakout)

closeLocation = input.float(
     0.55,
     "Minimum Close Location",
     minval=0.0,
     maxval=1.0,
     step=0.05,
     group=groupBreakout)

requireMomentumCandle = input.bool(
     false,
     "Require Strong Momentum Candle",
     group=groupBreakout)

minimumBodyPct = input.float(
     40.0,
     "Minimum Candle Body %",
     minval=0.0,
     maxval=100.0,
     step=5.0,
     group=groupBreakout)


//----------------------------------------------------
// RISK
//----------------------------------------------------
groupRisk = "5. Risk Management"

takeProfitR = input.float(
     2.0,
     "Take Profit (R)",
     minval=0.25,
     step=0.25,
     group=groupRisk)

stopLossBuffer = input.float(
     0.50,
     "Stop Loss Buffer %",
     minval=0.0,
     step=0.1,
     group=groupRisk)


//----------------------------------------------------
// VISUALS
//----------------------------------------------------
groupVisual = "6. Visuals"

showSMA = input.bool(
     true,
     "Show SMA",
     group=groupVisual)

showVCPBox = input.bool(
     true,
     "Show VCP Base Box",
     group=groupVisual)

showSR = input.bool(
     true,
     "Show Support / Resistance",
     group=groupVisual)

showTradeLevels = input.bool(
     true,
     "Show Entry / SL / TP",
     group=groupVisual)

showPriceInLabels = input.bool(
     true,
     "Show Prices In Labels",
     group=groupVisual)

labelOffsetBars = input.int(
     7,
     "Label Distance From Candles",
     minval=2,
     maxval=30,
     group=groupVisual)

showDebug = input.bool(
     false,
     "Show Debug Markers",
     group=groupVisual)


//====================================================
// COLORS
//====================================================

colorBull = color.rgb(0, 170, 100)
colorBear = color.rgb(220, 50, 70)
colorBlue = color.rgb(35, 105, 210)
colorOrange = color.rgb(245, 150, 20)


//====================================================
// TREND
//====================================================

sma = ta.sma(close, smaLength)

bullTrend = close > sma
bearTrend = close < sma

longTrendOK =
     not useTrendFilter or bullTrend

shortTrendOK =
     not useTrendFilter or bearTrend


//====================================================
// CANDLE MEASUREMENTS
//====================================================

candleRange =
     math.max(high - low, syminfo.mintick)

bullCloseLocation =
     (close - low) / candleRange

bearCloseLocation =
     (high - close) / candleRange

bodySize =
     math.abs(close - open)

bodyPct =
     bodySize / candleRange * 100.0

bullMomentum =
     close > open and
     bullCloseLocation >= closeLocation and
     (
         not requireMomentumCandle or
         bodyPct >= minimumBodyPct
     )

bearMomentum =
     close < open and
     bearCloseLocation >= closeLocation and
     (
         not requireMomentumCandle or
         bodyPct >= minimumBodyPct
     )


//====================================================
// BASE MEASUREMENTS
//====================================================

baseHigh =
     ta.highest(high, baseLookback)

baseLow =
     ta.lowest(low, baseLookback)

baseMid =
     (baseHigh + baseLow) / 2.0

baseRangePct =
     baseMid > 0 ?
     (baseHigh - baseLow) / baseMid * 100.0 :
     999.0


//====================================================
// TIGHT RANGE
//====================================================

tightHigh =
     ta.highest(high, tightLookback)

tightLow =
     ta.lowest(low, tightLookback)

tightMid =
     (tightHigh + tightLow) / 2.0

tightRangePct =
     tightMid > 0 ?
     (tightHigh - tightLow) / tightMid * 100.0 :
     999.0


//====================================================
// PREVIOUS STRUCTURE
//====================================================

// VERY IMPORTANT:
// Current candle is excluded.
// This allows the current candle to actually
// break the previous resistance/support.

previousResistance =
     ta.highest(high[1], baseLookback)

previousSupport =
     ta.lowest(low[1], baseLookback)


//====================================================
// TIGHTENING
//====================================================

earlierLookback =
     math.max(baseLookback - tightLookback, 2)

earlierHigh =
     ta.highest(high[tightLookback], earlierLookback)

earlierLow =
     ta.lowest(low[tightLookback], earlierLookback)

earlierMid =
     (earlierHigh + earlierLow) / 2.0

earlierRangePct =
     earlierMid > 0 ?
     (earlierHigh - earlierLow) /
     earlierMid * 100.0 :
     999.0

rangeTightening =
     tightRangePct < earlierRangePct

tighteningOK =
     not requireTightening or
     rangeTightening


//====================================================
// VOLUME
//====================================================

avgVolume =
     ta.sma(volume, volumeLength)

baseAvgVolume =
     ta.sma(volume, baseLookback)

tightAvgVolume =
     ta.sma(volume, tightLookback)

volumeContracting =
     tightAvgVolume <=
     baseAvgVolume * volumeContractionRatio

volumeContractionOK =
     not useVolumeContraction or
     volumeContracting

volumeExpansion =
     volume >=
     avgVolume * breakoutVolumeMultiplier

breakoutVolumeOK =
     not useBreakoutVolume or
     volumeExpansion


//====================================================
// VCP QUALIFICATION
//====================================================

enoughBars =
     bar_index >= baseLookback + tightLookback

baseSmallEnough =
     baseRangePct <= maxBaseRangePct

tightSmallEnough =
     tightRangePct <= maxTightRangePct

vcpQualified =
     enoughBars and
     baseSmallEnough and
     tightSmallEnough and
     tighteningOK and
     volumeContractionOK


//====================================================
// STATE
//====================================================

// 0 = SEARCHING
// 1 = VCP ACTIVE
// 2 = TRADE ACTIVE

var int state = 0

var int setupStart = na

var float setupHigh = na
var float setupLow = na

var float setupResistance = na
var float setupSupport = na

var box vcpBox = na

// VCP labels
var label vcpLabel = na
var label resistanceLabel = na
var label supportLabel = na

// VCP lines
var line resistanceLine = na
var line supportLine = na

// Trade lines
var line entryLine = na
var line stopLine = na
var line targetLine = na

// Trade labels
var label signalLabel = na
var label entryLabel = na
var label stopLabel = na
var label targetLabel = na

var float activeEntry = na
var float activeStop = na
var float activeTarget = na

var int activeDirection = 0


//====================================================
// LABEL TEXT HELPERS
//====================================================

priceText(float price) =>
    showPriceInLabels ?
         str.tostring(price, format.mintick) :
         ""

percentText(float price, float reference) =>
    reference != 0 ?
         str.tostring(
             math.abs(price - reference) /
             reference * 100.0,
             "#.##"
         ) + "%" :
         ""


//====================================================
// DELETE VCP DRAWINGS
//====================================================

deleteVCPDrawings() =>

    if not na(vcpBox)
        box.delete(vcpBox)

    if not na(vcpLabel)
        label.delete(vcpLabel)

    if not na(resistanceLabel)
        label.delete(resistanceLabel)

    if not na(supportLabel)
        label.delete(supportLabel)

    if not na(resistanceLine)
        line.delete(resistanceLine)

    if not na(supportLine)
        line.delete(supportLine)


//====================================================
// DELETE ACTIVE TRADE DRAWINGS
//====================================================

deleteTradeDrawings() =>

    if not na(entryLine)
        line.delete(entryLine)

    if not na(stopLine)
        line.delete(stopLine)

    if not na(targetLine)
        line.delete(targetLine)

    if not na(entryLabel)
        label.delete(entryLabel)

    if not na(stopLabel)
        label.delete(stopLabel)

    if not na(targetLabel)
        label.delete(targetLabel)


//====================================================
// CREATE VCP SETUP
//====================================================

if state == 0 and vcpQualified

    state := 1

    setupStart := bar_index

    setupHigh := baseHigh
    setupLow := baseLow

    setupResistance := previousResistance
    setupSupport := previousSupport

    //------------------------------------------------
    // BOX
    //------------------------------------------------

    if showVCPBox

        vcpBox := box.new(
             left=bar_index - baseLookback + 1,
             top=baseHigh,
             right=bar_index,
             bottom=baseLow,
             border_color=color.new(colorBlue, 15),
             border_width=2,
             bgcolor=color.new(colorBlue, 90)
         )


    //------------------------------------------------
    // RESISTANCE
    //------------------------------------------------

    if showSR

        resistanceLine := line.new(
             x1=bar_index - baseLookback,
             y1=setupResistance,
             x2=bar_index + labelOffsetBars,
             y2=setupResistance,
             color=color.new(colorBear, 20),
             width=1,
             style=line.style_dashed
         )

        resistanceLabel := label.new(
             x=bar_index + labelOffsetBars,
             y=setupResistance,
             text="◆ Resistance\n" +
                  priceText(setupResistance),
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_left,
             color=color.new(colorBear, 10),
             textcolor=color.white,
             size=size.small
         )


    //------------------------------------------------
    // SUPPORT
    //------------------------------------------------

    if showSR

        supportLine := line.new(
             x1=bar_index - baseLookback,
             y1=setupSupport,
             x2=bar_index + labelOffsetBars,
             y2=setupSupport,
             color=color.new(colorBull, 20),
             width=1,
             style=line.style_dashed
         )

        supportLabel := label.new(
             x=bar_index + labelOffsetBars,
             y=setupSupport,
             text="◆ Support\n" +
                  priceText(setupSupport),
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_left,
             color=color.new(colorBull, 10),
             textcolor=color.white,
             size=size.small
         )


    //------------------------------------------------
    // VCP BASE LABEL
    //------------------------------------------------

    if showVCPBox

        vcpLabel := label.new(
             x=bar_index - math.floor(baseLookback / 2),
             y=baseLow,
             text="◉ VCP BASE",
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_label_up,
             color=color.new(colorBlue, 10),
             textcolor=color.white,
             size=size.small
         )


//====================================================
// MANAGE VCP
//====================================================

if state == 1

    setupBars =
         bar_index - setupStart + 1


    //------------------------------------------------
    // UPDATE STRUCTURE
    //------------------------------------------------

    setupHigh := ta.highest(high, baseLookback)
    setupLow := ta.lowest(low, baseLookback)

    setupResistance := ta.highest(high[1], baseLookback)
    setupSupport := ta.lowest(low[1], baseLookback)


    //------------------------------------------------
    // UPDATE BOX
    //------------------------------------------------

    if showVCPBox and not na(vcpBox)

        box.set_right(
             vcpBox,
             bar_index
         )

        box.set_top(
             vcpBox,
             setupHigh
         )

        box.set_bottom(
             vcpBox,
             setupLow
         )


    //------------------------------------------------
    // UPDATE RESISTANCE
    //------------------------------------------------

    if showSR and not na(resistanceLine)

        line.set_y1(
             resistanceLine,
             setupResistance
         )

        line.set_y2(
             resistanceLine,
             setupResistance
         )

        line.set_x2(
             resistanceLine,
             bar_index + labelOffsetBars
         )


    if showSR and not na(resistanceLabel)

        label.set_xy(
             resistanceLabel,
             bar_index + labelOffsetBars,
             setupResistance
         )

        label.set_text(
             resistanceLabel,
             "◆ Resistance\n" +
             priceText(setupResistance)
         )


    //------------------------------------------------
    // UPDATE SUPPORT
    //------------------------------------------------

    if showSR and not na(supportLine)

        line.set_y1(
             supportLine,
             setupSupport
         )

        line.set_y2(
             supportLine,
             setupSupport
         )

        line.set_x2(
             supportLine,
             bar_index + labelOffsetBars
         )


    if showSR and not na(supportLabel)

        label.set_xy(
             supportLabel,
             bar_index + labelOffsetBars,
             setupSupport
         )

        label.set_text(
             supportLabel,
             "◆ Support\n" +
             priceText(setupSupport)
         )


    //------------------------------------------------
    // EXPIRE SETUP
    //------------------------------------------------

    if setupBars > maxSetupBars

        deleteVCPDrawings()

        vcpBox := na
        vcpLabel := na

        resistanceLabel := na
        supportLabel := na

        resistanceLine := na
        supportLine := na

        state := 0

        setupStart := na
        setupHigh := na
        setupLow := na


    else

        //------------------------------------------------
        // BREAKOUT
        //------------------------------------------------

        bullBreak =
             close >
             setupResistance *
             (1.0 + breakoutBuffer / 100.0)

        bearBreak =
             close <
             setupSupport *
             (1.0 - breakoutBuffer / 100.0)


        longSignal =
             setupBars >= minSetupBars and
             bullBreak and
             bullMomentum and
             longTrendOK and
             breakoutVolumeOK


        shortSignal =
             setupBars >= minSetupBars and
             bearBreak and
             bearMomentum and
             shortTrendOK and
             breakoutVolumeOK


        //------------------------------------------------
        // LONG SIGNAL
        //------------------------------------------------

        if longSignal

            entry = close

            stop =
                 setupSupport *
                 (1.0 - stopLossBuffer / 100.0)

            risk =
                 math.abs(entry - stop)

            target =
                 entry +
                 risk * takeProfitR


            //------------------------------------------------
            // REMOVE VCP DRAWINGS
            //------------------------------------------------

            deleteVCPDrawings()

            vcpBox := na
            vcpLabel := na

            resistanceLabel := na
            supportLabel := na

            resistanceLine := na
            supportLine := na


            //------------------------------------------------
            // STORE TRADE
            //------------------------------------------------

            activeEntry := entry
            activeStop := stop
            activeTarget := target

            activeDirection := 1

            state := 2


            //------------------------------------------------
            // BUY LABEL
            //------------------------------------------------

            signalLabel := label.new(
                 x=bar_index,
                 y=low,
                 text="▲ BUY",
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_up,
                 color=color.new(colorBull, 5),
                 textcolor=color.white,
                 size=size.small
             )


            //------------------------------------------------
            // TRADE LEVELS
            //------------------------------------------------

            if showTradeLevels

                entryLine := line.new(
                     x1=bar_index,
                     y1=entry,
                     x2=bar_index + labelOffsetBars,
                     y2=entry,
                     color=color.new(colorBlue, 15),
                     width=2,
                     style=line.style_dashed
                 )

                stopLine := line.new(
                     x1=bar_index,
                     y1=stop,
                     x2=bar_index + labelOffsetBars,
                     y2=stop,
                     color=color.new(colorBear, 15),
                     width=2
                 )

                targetLine := line.new(
                     x1=bar_index,
                     y1=target,
                     x2=bar_index + labelOffsetBars,
                     y2=target,
                     color=color.new(colorBull, 15),
                     width=2,
                     style=line.style_dashed
                 )


                //------------------------------------------------
                // ENTRY LABEL
                //------------------------------------------------

                entryLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=entry,
                     text="▶ Entry\n" +
                          priceText(entry),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBlue, 5),
                     textcolor=color.white,
                     size=size.small
                 )


                //------------------------------------------------
                // STOP LABEL
                //------------------------------------------------

                stopLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=stop,
                     text="◆ Stop\n" +
                          priceText(stop) +
                          " (-" +
                          percentText(stop, entry) +
                          ")",
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBear, 5),
                     textcolor=color.white,
                     size=size.small
                 )


                //------------------------------------------------
                // TARGET LABEL
                //------------------------------------------------

                targetLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=target,
                     text="◎ Target\n" +
                          priceText(target) +
                          " (+" +
                          percentText(target, entry) +
                          ")",
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBull, 5),
                     textcolor=color.white,
                     size=size.small
                 )


        //------------------------------------------------
        // SHORT SIGNAL
        //------------------------------------------------

        else if shortSignal

            entry = close

            stop =
                 setupResistance *
                 (1.0 + stopLossBuffer / 100.0)

            risk =
                 math.abs(entry - stop)

            target =
                 entry -
                 risk * takeProfitR


            //------------------------------------------------
            // REMOVE VCP DRAWINGS
            //------------------------------------------------

            deleteVCPDrawings()

            vcpBox := na
            vcpLabel := na

            resistanceLabel := na
            supportLabel := na

            resistanceLine := na
            supportLine := na


            //------------------------------------------------
            // STORE TRADE
            //------------------------------------------------

            activeEntry := entry
            activeStop := stop
            activeTarget := target

            activeDirection := -1

            state := 2


            //------------------------------------------------
            // SELL LABEL
            //------------------------------------------------

            signalLabel := label.new(
                 x=bar_index,
                 y=high,
                 text="▼ SELL",
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_down,
                 color=color.new(colorBear, 5),
                 textcolor=color.white,
                 size=size.small
             )


            //------------------------------------------------
            // TRADE LEVELS
            //------------------------------------------------

            if showTradeLevels

                entryLine := line.new(
                     x1=bar_index,
                     y1=entry,
                     x2=bar_index + labelOffsetBars,
                     y2=entry,
                     color=color.new(colorBlue, 15),
                     width=2,
                     style=line.style_dashed
                 )

                stopLine := line.new(
                     x1=bar_index,
                     y1=stop,
                     x2=bar_index + labelOffsetBars,
                     y2=stop,
                     color=color.new(colorBear, 15),
                     width=2
                 )

                targetLine := line.new(
                     x1=bar_index,
                     y1=target,
                     x2=bar_index + labelOffsetBars,
                     y2=target,
                     color=color.new(colorBull, 15),
                     width=2,
                     style=line.style_dashed
                 )


                //------------------------------------------------
                // ENTRY
                //------------------------------------------------

                entryLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=entry,
                     text="▶ Entry\n" +
                          priceText(entry),
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBlue, 5),
                     textcolor=color.white,
                     size=size.small
                 )


                //------------------------------------------------
                // STOP
                //------------------------------------------------

                stopLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=stop,
                     text="◆ Stop\n" +
                          priceText(stop) +
                          " (-" +
                          percentText(stop, entry) +
                          ")",
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBear, 5),
                     textcolor=color.white,
                     size=size.small
                 )


                //------------------------------------------------
                // TARGET
                //------------------------------------------------

                targetLabel := label.new(
                     x=bar_index + labelOffsetBars,
                     y=target,
                     text="◎ Target\n" +
                          priceText(target) +
                          " (+" +
                          percentText(target, entry) +
                          ")",
                     xloc=xloc.bar_index,
                     yloc=yloc.price,
                     style=label.style_label_left,
                     color=color.new(colorBull, 5),
                     textcolor=color.white,
                     size=size.small
                 )


//====================================================
// ACTIVE TRADE MANAGEMENT
//====================================================

if state == 2

    //------------------------------------------------
    // Extend lines
    //------------------------------------------------

    if showTradeLevels

        if not na(entryLine)

            line.set_x2(
                 entryLine,
                 bar_index + labelOffsetBars
             )

        if not na(stopLine)

            line.set_x2(
                 stopLine,
                 bar_index + labelOffsetBars
             )

        if not na(targetLine)

            line.set_x2(
                 targetLine,
                 bar_index + labelOffsetBars
             )


        //------------------------------------------------
        // Keep labels away from current candles
        //------------------------------------------------

        if not na(entryLabel)

            label.set_x(
                 entryLabel,
                 bar_index + labelOffsetBars
             )

        if not na(stopLabel)

            label.set_x(
                 stopLabel,
                 bar_index + labelOffsetBars
             )

        if not na(targetLabel)

            label.set_x(
                 targetLabel,
                 bar_index + labelOffsetBars
             )


    //------------------------------------------------
    // CHECK TP / SL
    //------------------------------------------------

    hitTarget =
         activeDirection == 1 ?
         high >= activeTarget :
         low <= activeTarget

    hitStop =
         activeDirection == 1 ?
         low <= activeStop :
         high >= activeStop


    //------------------------------------------------
    // EXIT
    //------------------------------------------------

    if hitTarget or hitStop

        if hitStop

            label.new(
                 x=bar_index + 2,
                 y=activeStop,
                 text="✕ SL HIT",
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=color.new(colorBear, 5),
                 textcolor=color.white,
                 size=size.small
             )

        else

            label.new(
                 x=bar_index + 2,
                 y=activeTarget,
                 text="✓ TP HIT",
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=color.new(colorBull, 5),
                 textcolor=color.white,
                 size=size.small
             )


        //------------------------------------------------
        // RESET
        //------------------------------------------------

        state := 0

        activeDirection := 0

        activeEntry := na
        activeStop := na
        activeTarget := na

        if not na(entryLine)
            line.delete(entryLine)

        if not na(stopLine)
            line.delete(stopLine)

        if not na(targetLine)
            line.delete(targetLine)

        if not na(entryLabel)
            label.delete(entryLabel)

        if not na(stopLabel)
            label.delete(stopLabel)

        if not na(targetLabel)
            label.delete(targetLabel)

        entryLine := na
        stopLine := na
        targetLine := na

        entryLabel := na
        stopLabel := na
        targetLabel := na


//====================================================
// SMA
//====================================================

plot(
     showSMA ? sma : na,
     title="SMA 50",
     color=colorOrange,
     linewidth=2
)


//====================================================
// DEBUG
//====================================================

plotshape(
     showDebug and vcpQualified,
     title="VCP Qualified",
     style=shape.circle,
     location=location.belowbar,
     color=colorBlue,
     size=size.tiny,
     text="VCP"
)

plotshape(
     showDebug and volumeExpansion,
     title="Volume Expansion",
     style=shape.circle,
     location=location.bottom,
     color=color.purple,
     size=size.tiny,
     text="VOL"
)