# Telegram Notifications Setup
# Both naming formats are supported across scripts (daily_report.py & live_scanner.py)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Alternative shorthand keys:
# TG_BOT_TOKEN=your_bot_token_here
# TG_CHAT_ID=your_chat_id_here

# ==============================================================================
# Telegram Heartbeat Pulse (40-minute and startup notifications)
# ==============================================================================
# Set to false to suppress 40-minute Telegram pulses (internal health watchdog remains 100% active)
ENABLE_HEARTBEAT_ALERT=true

# ==============================================================================
# Market Orchestration & Scan Target Controls
# ==============================================================================
# Comma-separated list of active markets (Options: US, NSE, CRYPTO, TSE, HKEX)
ENABLED_MARKETS=US,NSE,CRYPTO

# Individual market switches (override ENABLED_MARKETS if set)
# ENABLE_CRYPTO=false
# ENABLE_NSE=true
# ENABLE_US=true

